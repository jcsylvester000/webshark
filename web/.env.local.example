# Slyshark on your own computer. `local\setup.ps1` writes web/.env.local from this file.
# Never commit .env.local: it holds your database password.

# Pick ONE database:
#  - Local Docker Postgres (docker-compose.yml at the repo root):
DATABASE_URL=postgresql://slyshark:slyshark@localhost:5433/slyshark
#  - or Neon (pooled connection string from the Neon console):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/slyshark?sslmode=require

# Creates/resets testuser / password123 on every migration. Fine on your own PC.
SEED_TEST_USER=true

# Local only: allow tests against your home/office/lab network (192.168.x.x, 10.x, localhost).
# Leave this OFF on any server other people can reach. 169.254.0.0/16 (cloud metadata) stays blocked.
ALLOW_PRIVATE_TARGETS=true

# Local machines have no 10-second serverless limit: allow longer tools and bigger scan batches.
TOOL_BUDGET_MS=30000
MAX_SCAN_PORTS=1000

# Lets you sign in from another device on your network over plain http://<this-PC-IP>:3000.
COOKIE_SECURE=false

SESSION_TTL_HOURS=168
