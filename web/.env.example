# Slyshark configuration. Local: copy to `.env.local`. Netlify: add the same keys under
# Site configuration > Environment variables (scopes: Builds + Functions). Never commit real values.

# Neon Postgres: Neon console > your project > Connect > "Pooled connection" (host contains -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/slyshark?sslmode=require

# Creates/resets testuser / password123 when migrations run. Set to false once real users sign up.
SEED_TEST_USER=true

# Allow ping/scan/http against private and loopback addresses. Default: true in local dev,
# false in production (prevents SSRF). Cloud metadata (169.254.0.0/16) is always blocked.
# ALLOW_PRIVATE_TARGETS=false

# Max time (ms) for one tool request. Netlify synchronous functions stop at 10 s by default.
TOOL_BUDGET_MS=8500

# Max ports per scan request (the UI batches 200 at a time).
MAX_SCAN_PORTS=400

# Session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168
