# Slyshark API configuration. Copy to `.env` and fill in. Never commit `.env`.

# Neon Postgres connection string: Neon console > your project > Connect.
# Use the DIRECT connection (host without "-pooler"): the API is a long-running server with
# its own pool, and migrations need session-level advisory locks. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.REGION.aws.neon.tech/slyshark?sslmode=require

# Address the API listens on. The Next.js app calls this through API_URL.
BIND_ADDR=127.0.0.1:8080

# Origin of the Next.js web app (CORS).
WEB_ORIGIN=http://localhost:3000

# Session lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168

# Development only: creates/resets testuser / password123 on startup. Set false in production.
SEED_TEST_USER=true

# Allow ping/scan/http against private and loopback addresses (your LAN, localhost).
# Keep true for self-hosted use. Set false if strangers can sign up, to prevent SSRF.
# Cloud metadata (169.254.0.0/16) is always blocked.
ALLOW_PRIVATE_TARGETS=true

# Maximum number of ports in one scan.
MAX_SCAN_PORTS=2048

RUST_LOG=slyshark_api=info,tower_http=info
